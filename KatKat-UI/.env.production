# Production backend. This is the ONE file to edit once a real domain exists -
# everything else in the app reads its API/auth/SignalR URLs from src/config/appConfig.ts,
# which only ever reads these VITE_* variables. Used by `npm run build` / `npm run preview`.
VITE_API_BASE_URL=https://api.katkat.com
VITE_AUTH_AUTHORITY=https://api.katkat.com
VITE_SIGNALR_HUB_URL=https://api.katkat.com/signalr-hubs/katkat
VITE_OAUTH_CLIENT_ID=KatKat_App
