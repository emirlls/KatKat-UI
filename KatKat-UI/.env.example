# Copy to .env.local to override the committed .env.development/.env.production values
# without touching tracked files (Vite loads .env.local last, see vite.config.ts docs).
VITE_API_BASE_URL=https://localhost:44353
VITE_AUTH_AUTHORITY=https://localhost:44353
VITE_SIGNALR_HUB_URL=https://localhost:44353/signalr-hubs/katkat
VITE_OAUTH_CLIENT_ID=KatKat_App
