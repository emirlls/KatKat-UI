# Used when building the frontend's Docker image (see Dockerfile: `npm run build:docker`).
# Points at the dockerized backend's published host port (see ../docker-compose.yml in the
# KatKat backend repo: api service publishes 8080). This container itself publishes on 3000
# (see docker-compose.yml here), matching appsettings.Docker.json's CorsOrigins/RootUrl on the backend.
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_AUTHORITY=http://localhost:8080
VITE_SIGNALR_HUB_URL=http://localhost:8080/signalr-hubs/katkat
VITE_OAUTH_CLIENT_ID=KatKat_App
